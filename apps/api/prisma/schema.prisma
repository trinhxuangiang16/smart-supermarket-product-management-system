generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  WAREHOUSE_STAFF
  CASHIER
  SALE_DEPARTMENT
  FINANCE_DEPARTMENT
}

enum ProductType {
  FRESH_FOOD
  DRY_GOODS
  COSMETICS
  HOUSEHOLD
  CUSTOM
}

enum PricingUnit {
  PIECE
  KG
  G
  L
  ML
  BOX
}

enum ExpiryStatus {
  NORMAL
  WARNING_15
  ALERT_3
  EXPIRED
  DESTROYED
}

enum TransactionType {
  IN
  OUT
  ADJUSTMENT
  DESTROY
}

enum DestroyReason {
  EXPIRED
  DAMAGED
  CONTAMINATED
  OTHER
}

enum ApprovalRequestType {
  PRODUCT_UPDATE
  PRODUCT_DELETE
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AssetStatus {
  ACTIVE
  IN_REPAIR
  RETIRED
  LOST
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  role           Role
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assignedAssets Asset[]  @relation("assetAssignee")
  employee       Employee?
  products       Product[]
  transactions   InventoryTransaction[] @relation("performedBy")
  approvals      InventoryTransaction[] @relation("approvedBy")
  auditLogs      AuditLog[]
  priceHistories PriceHistory[]
  requestedApprovals ApprovalRequest[] @relation("approvalRequestedBy")
  reviewedApprovals  ApprovalRequest[] @relation("approvalReviewedBy")
  sessions       UserSession[]
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    Product[]
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")

  @@index([parentId])
}

model Supplier {
  id           String   @id @default(cuid())
  name         String
  contactEmail String?
  contactPhone String?
  address      String?
  contactPerson String?
  notes        String?   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  products     Product[]
}

model Product {
  id            String       @id @default(cuid())
  name          String
  brand         String?
  manufacturer  String?
  sku           String       @unique
  barcode       String?      @unique
  type          ProductType
  unit          PricingUnit
  costPrice     Decimal      @db.Decimal(12, 2)
  sellingPrice  Decimal      @db.Decimal(12, 2)
  profitMargin  Decimal      @db.Decimal(8, 2) @default(0)
  currentStock  Decimal      @db.Decimal(12, 3) @default(0)
  reorderLevel  Decimal      @db.Decimal(12, 3) @default(0)
  productionDate DateTime?
  expiryDate    DateTime?
  expiryStatus  ExpiryStatus @default(NORMAL)
  imageUrl      String?
  notes         String?
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  categoryId    String
  supplierId    String?
  category      Category     @relation(fields: [categoryId], references: [id])
  supplier      Supplier?    @relation(fields: [supplierId], references: [id])
  createdBy     User         @relation(fields: [createdById], references: [id])
  transactions  InventoryTransaction[]
  approvalRequests ApprovalRequest[]
  priceHistories PriceHistory[]
  isDeleted     Boolean      @default(false)
  deletedAt     DateTime?

  @@index([name])
  @@index([categoryId])
  @@index([supplierId])
  @@index([expiryDate])
  @@index([expiryStatus])
  @@index([currentStock])
  @@index([isDeleted])
}

model ApprovalRequest {
  id               String                @id @default(cuid())
  type             ApprovalRequestType
  status           ApprovalRequestStatus @default(PENDING)
  productId        String
  requestedById    String
  reviewedById     String?
  reason           String                @db.Text
  reviewNote       String?               @db.Text
  requestedChanges Json?
  before           Json?
  createdAt        DateTime              @default(now())
  reviewedAt       DateTime?
  product          Product               @relation(fields: [productId], references: [id])
  requestedBy      User                  @relation("approvalRequestedBy", fields: [requestedById], references: [id])
  reviewedBy       User?                 @relation("approvalReviewedBy", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([type])
  @@index([productId])
  @@index([requestedById])
  @@index([createdAt])
}

model InventoryTransaction {
  id            String          @id @default(cuid())
  productId     String
  type          TransactionType
  quantity      Decimal         @db.Decimal(12, 3)
  unitPrice     Decimal?        @db.Decimal(12, 2)
  totalValue    Decimal?        @db.Decimal(12, 2)
  invoiceNumber String?
  supplierName  String?
  deliveredByName String?
  deliveredAt   DateTime?
  reason        String?
  destroyReason DestroyReason?
  performedById String
  approvedById  String?
  warehouseId   String?
  createdAt     DateTime        @default(now())
  product       Product         @relation(fields: [productId], references: [id])
  performedBy   User            @relation("performedBy", fields: [performedById], references: [id])
  approvedBy    User?           @relation("approvedBy", fields: [approvedById], references: [id])
  warehouse     Warehouse?      @relation(fields: [warehouseId], references: [id])

  @@index([type])
  @@index([createdAt])
  @@index([warehouseId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  requestId String?
  before    Json?
  after     Json?
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([requestId, createdAt])
}

model PriceHistory {
  id              String   @id @default(cuid())
  productId       String
  oldCostPrice    Decimal  @db.Decimal(12, 2)
  newCostPrice    Decimal  @db.Decimal(12, 2)
  oldSellingPrice Decimal  @db.Decimal(12, 2)
  newSellingPrice Decimal  @db.Decimal(12, 2)
  changedById     String
  createdAt       DateTime @default(now())
  product         Product  @relation(fields: [productId], references: [id])
  changedBy       User     @relation(fields: [changedById], references: [id])

  @@index([productId, createdAt])
  @@index([changedById, createdAt])
}

model UserSession {
  id            String   @id @default(cuid())
  userId        String
  refreshToken  String   @unique @db.VarChar(512)
  userAgent     String?
  ipAddress     String?
  deviceLabel   String?
  lastActiveAt  DateTime @default(now())
  revokedAt     DateTime?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, revokedAt])
}

model Asset {
  id                 String      @id @default(cuid())
  code               String      @unique
  name               String
  type               String
  status             AssetStatus @default(ACTIVE)
  purchaseDate       DateTime
  cost               Decimal     @db.Decimal(14, 2)
  depreciationMonths Int         @default(0)
  warehouseId        String?
  assignedUserId     String?
  notes              String?
  isDeleted          Boolean     @default(false)
  deletedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  warehouse          Warehouse?  @relation(fields: [warehouseId], references: [id])
  assignedUser       User?       @relation("assetAssignee", fields: [assignedUserId], references: [id])

  @@index([name])
  @@index([type])
  @@index([status])
  @@index([warehouseId])
  @@index([isDeleted])
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentTree")
  employees Employee[]

  @@index([parentId])
}

model Employee {
  id           String         @id @default(cuid())
  code         String         @unique
  fullName     String
  email        String?        @unique
  phone        String?
  departmentId String
  position     String
  hireDate     DateTime
  salary       Decimal        @db.Decimal(14, 2)
  status       EmployeeStatus @default(ACTIVE)
  userId       String?        @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  department   Department     @relation(fields: [departmentId], references: [id])
  user         User?          @relation(fields: [userId], references: [id])

  @@index([fullName])
  @@index([departmentId])
  @@index([status])
}

model InsightRun {
  id         String   @id @default(cuid())
  topic      String
  inputHash  String
  resultJson Json
  createdAt  DateTime @default(now())

  @@unique([topic, inputHash])
  @@index([topic, createdAt])
}

model AiSetting {
  id        String   @id @default(cuid())
  provider  String   @unique
  apiKey    String?  @db.VarChar(512)
  model     String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Warehouse {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  transactions InventoryTransaction[]
  assets       Asset[]

  @@index([name])
  @@index([isActive])
}
