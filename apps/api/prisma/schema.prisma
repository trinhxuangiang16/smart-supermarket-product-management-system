generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  WAREHOUSE_STAFF
  CASHIER
  SALE_DEPARTMENT
  FINANCE_DEPARTMENT
}

enum ProductType {
  FRESH_FOOD
  DRY_GOODS
  COSMETICS
  HOUSEHOLD
  CUSTOM
}

enum PricingUnit {
  PIECE
  KG
  G
  L
  ML
  BOX
}

enum ExpiryStatus {
  NORMAL
  WARNING_15
  ALERT_3
  EXPIRED
  DESTROYED
}

enum TransactionType {
  IN
  OUT
  ADJUSTMENT
  DESTROY
}

enum DestroyReason {
  EXPIRED
  DAMAGED
  CONTAMINATED
  OTHER
}

enum ApprovalRequestType {
  PRODUCT_UPDATE
  PRODUCT_DELETE
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  role           Role
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  products       Product[]
  transactions   InventoryTransaction[] @relation("performedBy")
  approvals      InventoryTransaction[] @relation("approvedBy")
  auditLogs      AuditLog[]
  requestedApprovals ApprovalRequest[] @relation("approvalRequestedBy")
  reviewedApprovals  ApprovalRequest[] @relation("approvalReviewedBy")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    Product[]
}

model Supplier {
  id           String   @id @default(cuid())
  name         String
  contactEmail String?
  contactPhone String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  products     Product[]
}

model Product {
  id            String       @id @default(cuid())
  name          String
  brand         String?
  manufacturer  String?
  sku           String       @unique
  barcode       String?      @unique
  type          ProductType
  unit          PricingUnit
  costPrice     Decimal      @db.Decimal(12, 2)
  sellingPrice  Decimal      @db.Decimal(12, 2)
  profitMargin  Decimal      @db.Decimal(8, 2) @default(0)
  currentStock  Decimal      @db.Decimal(12, 3) @default(0)
  reorderLevel  Decimal      @db.Decimal(12, 3) @default(0)
  productionDate DateTime?
  expiryDate    DateTime?
  expiryStatus  ExpiryStatus @default(NORMAL)
  imageUrl      String?
  notes         String?
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  categoryId    String
  supplierId    String?
  category      Category     @relation(fields: [categoryId], references: [id])
  supplier      Supplier?    @relation(fields: [supplierId], references: [id])
  createdBy     User         @relation(fields: [createdById], references: [id])
  transactions  InventoryTransaction[]
  approvalRequests ApprovalRequest[]
  isDeleted     Boolean      @default(false)
  deletedAt     DateTime?

  @@index([name])
  @@index([categoryId])
  @@index([supplierId])
  @@index([expiryDate])
  @@index([expiryStatus])
  @@index([currentStock])
  @@index([isDeleted])
}

model ApprovalRequest {
  id               String                @id @default(cuid())
  type             ApprovalRequestType
  status           ApprovalRequestStatus @default(PENDING)
  productId        String
  requestedById    String
  reviewedById     String?
  reason           String                @db.Text
  requestedChanges Json?
  before           Json?
  createdAt        DateTime              @default(now())
  reviewedAt       DateTime?
  product          Product               @relation(fields: [productId], references: [id])
  requestedBy      User                  @relation("approvalRequestedBy", fields: [requestedById], references: [id])
  reviewedBy       User?                 @relation("approvalReviewedBy", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([type])
  @@index([productId])
  @@index([requestedById])
  @@index([createdAt])
}

model InventoryTransaction {
  id            String          @id @default(cuid())
  productId     String
  type          TransactionType
  quantity      Decimal         @db.Decimal(12, 3)
  unitPrice     Decimal?        @db.Decimal(12, 2)
  totalValue    Decimal?        @db.Decimal(12, 2)
  invoiceNumber String?
  supplierName  String?
  deliveredByName String?
  deliveredAt   DateTime?
  reason        String?
  destroyReason DestroyReason?
  performedById String
  approvedById  String?
  createdAt     DateTime        @default(now())
  product       Product         @relation(fields: [productId], references: [id])
  performedBy   User            @relation("performedBy", fields: [performedById], references: [id])
  approvedBy    User?           @relation("approvedBy", fields: [approvedById], references: [id])

  @@index([type])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
